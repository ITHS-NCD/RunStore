<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Client.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.AddView"
             x:DataType="vm:AddViewModel"
             FontSize="30"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             Padding="30"
             Foreground="{DynamicResource PrimaryTextColor}"
             Background="{DynamicResource PrimaryBackgroundColor}">

             <Design.DataContext><vm:AddViewModel/></Design.DataContext>
            
             <StackPanel>
              <Border BorderBrush="White" BorderThickness="0 0 0 1">
             <TextBlock Classes="h1" Text="{Binding PageTitle}" FontSize="28" />
             </Border>

             <Border>
              <StackPanel Spacing="20" Margin="5 30">
                <Button Content="Klicka för att lägga till en Produkt" Background="{DynamicResource PrimaryBackgroundGradient}"></Button>
                <Button Content="Klicka för att lägga till en Kund" Background="{DynamicResource PrimaryBackgroundGradient}"></Button>
                <Button Content="Klicka för att lägga till en Beställning" Background="{DynamicResource PrimaryBackgroundGradient}"></Button>
              </StackPanel>
             </Border>
             </StackPanel>
  
</UserControl>

