<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.ProductsView"
             x:DataType="vm:ProductsViewModel"
             Foreground="{DynamicResource PrimaryTextColor}"
             Background="{DynamicResource PrimaryBackgroundColor}">

             <Design.DataContext>
              <vm:ProductsViewModel/>
             </Design.DataContext>

             <StackPanel>
               <TextBlock Classes="h1" Text="{Binding PageTitle}" />
              
              <Border BorderBrush="White" BorderThickness="0 0 0 1" Padding="5 0 5 2" Margin="10 5">
                <Grid ColumnDefinitions="200,300,200,*,60,60">
                  <Label Content="Artikelnummer" FontSize="20" />
                  <Label Grid.Column="1" Content="Namn" FontSize="20" />
                  <Label Grid.Column="2" Content="Leveratör" FontSize="20" />
                  <Label Grid.Column="3" Content="Pris" FontSize="20" HorizontalAlignment="Right" />
                </Grid>
              </Border>


               <ItemsControl ItemsSource="{Binding Products}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="200,300,200,*,auto,auto" Margin="10 2" VerticalAlignment="Center">
                        <Label Content="{Binding ItemNumber}"  FontSize="20" />
                        <Label Content="{Binding Name}" Grid.Column="1" FontSize="20" />
                        <Label Content="{Binding SupplierName}" Grid.Column="2" FontSize="20" />
                        <Label Content="{Binding Price}" FontSize="20" Grid.Column="3" HorizontalAlignment="Right" />
                        <Button Command="{Binding Edit}" FontFamily="{DynamicResource IconFont}" Content="&#xE34C;" Foreground="LightGreen" FontSize="26" Grid.Column="4" Padding="10 0 0 10"> </Button>
                        <Button Command="{Binding Delete}" FontFamily="{DynamicResource IconFont}" Content="&#xE4F6;" Foreground="Red" FontSize="26" Grid.Column="5" Padding="10 0 0 10"></Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
               
             </StackPanel>
</UserControl>
