<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Client.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Client.Views.MainWindow"
        Title="Client">

        <Design.DataContext><vm:MainWindowViewModel/></Design.DataContext>

        <Grid ColumnDefinitions="200,*" Background="{DynamicResource PrimaryBackgroundColor}">
            <Border Background="{DynamicResource PrimaryBackgroundGradient}" Padding="4">
                <Grid RowDefinitions="*,Auto" Margin="5">
                    <StackPanel Grid.Row="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="20" Margin="3">
                            <Image Width="48" Height="48" Source="avares://Client/Assets/Images/runstore.png" />
                            <TextBlock Text="Run Store" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextColor}" FontSize="20" />
                        </StackPanel>
                        <Button Command="{Binding GoToHomeCommand}" Content="Hem" FontSize="16" HorizontalAlignment="Stretch"></Button>
                        <Button Command="{Binding GoToProductsCommand}" Content="Produkter" FontSize="16" HorizontalAlignment="Stretch"></Button>
                    </StackPanel>
                    <Button Grid.Row="1" Command="{Binding GoToSettingsCommand}" Content="Inställningar" FontSize="16" HorizontalAlignment="Stretch"></Button>
                </Grid>
            </Border>
            <UserControl Content="{Binding CurrentView}" Grid.Column="1" Padding="20" />
        </Grid>
</Window>
